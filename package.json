{
    "name": "station-assigner",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:generate": "npm run db:generate -w backend",
        "db:migrate": "npm run db:migrate -w backend",
        "db:studio": "npm run db:studio -w backend"
    },
    "devDependencies": {
        "concurrently": "^10.0.7",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    }
}
